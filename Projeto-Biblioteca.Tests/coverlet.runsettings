<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>
            <ModulePath>.*\\pBiblioteca\\.Models\\.*</ModulePath>
            <ModulePath>.*\\pBiblioteca\\.DTO\\.*</ModulePath>
            <ModulePath>.*\\pBiblioteca\\.Repositories\\.*</ModulePath>
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>